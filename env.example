# --- Local model (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b   # confirmed on disk (4.9GB). Lightweight alternates also on disk: qwen2.5:3b, phi3:mini, llama3.2:3b
OLLAMA_NUM_CTX=8192

# --- Cloud fallback (only used when routing escalates) ---
ANTHROPIC_API_KEY=

# --- File manager ---
WATCHED_FOLDERS=C:\Users\<you>\Downloads,C:\Users\<you>\Desktop
# Reserved — nothing writes here yet. Phase 1 has no delete of any kind.
QUARANTINE_FOLDER=C:\Users\<you>\_Quarantine
BATCH_CONFIRM_THRESHOLD=5

# --- Logging ---
LOG_PATH=./logs/actions.log
